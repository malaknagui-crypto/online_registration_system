@page "/menu/{StudentId:int}/{FacultyId:int}/{MajorId:int}/{StudentName}"
@page "/menu/{StudentId:int}"
@using Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Student Dashboard</h2>
            @if (!string.IsNullOrEmpty(StudentName))
            {
                <p class="text-muted mb-0">Welcome back, @StudentName</p>
            }
        </div>
        <button class="btn btn-outline-secondary" @onclick="Logout">Logout</button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Online Registration Card -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h4 class="card-title text-primary">Online Registration</h4>
                        <p class="card-text text-muted">
                            Register for your upcoming semester courses, select your preferred section slots, and manage your weekly timetable.
                        </p>
                    </div>
                    <div class="mt-4">
                        <button class="btn btn-primary w-100"
                                disabled="@(!RegistrationPeriod.IsOpen || isLoading)"
                                @onclick="GoToRegistration">
                            Go to Registration
                        </button>
                        @if (!RegistrationPeriod.IsOpen)
                        {
                            <small class="text-danger d-block mt-2 text-center">
                                Registration opens @RegistrationPeriod.DisplayRange.
                            </small>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Print Unofficial Transcript Card -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-secondary">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h4 class="card-title text-secondary">Unofficial Transcript</h4>
                        <p class="card-text text-muted">
                            View and print your complete academic history, completed courses, grades, and cumulative GPA.
                        </p>
                    </div>
                    <div class="mt-4">
                        <button class="btn btn-outline-secondary w-100" @onclick="GoToTranscript">
                            Print Unofficial Transcript
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int StudentId { get; set; }
    [Parameter] public int FacultyId { get; set; }
    [Parameter] public int MajorId { get; set; }
    [Parameter] public string StudentName { get; set; } = string.Empty;

    private string errorMessage = string.Empty;
    private bool isLoading;

    // Reached via the short "/menu/{StudentId}" route (e.g. the Back buttons on the
    // other pages), so faculty/major/name have to be resolved from the server.
    protected override async Task OnParametersSetAsync()
    {
        if (FacultyId > 0 && MajorId > 0) return;

        isLoading = true;
        try
        {
            var header = await Http.GetFromJsonAsync<StudentHeaderDto>($"api/student/{StudentId}/header");
            if (header != null)
            {
                FacultyId = header.FacultyId;
                MajorId = header.MajorId;
                if (string.IsNullOrEmpty(StudentName))
                    StudentName = header.FullName;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load your student details: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToRegistration()
    {
        if (!RegistrationPeriod.IsOpen)
        {
            errorMessage = RegistrationPeriod.ClosedMessage;
            return;
        }

        Navigation.NavigateTo($"/registration/{StudentId}/{FacultyId}/{MajorId}");
    }

    private void GoToTranscript()
    {
        Navigation.NavigateTo($"/transcript/{StudentId}");
    }

    private void Logout()
    {
        Navigation.NavigateTo("/login");
    }
}
