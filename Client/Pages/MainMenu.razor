@page "/menu/{StudentId:int}/{MajorId:int}/{StudentName}"
@page "/menu/{StudentId:int}/{StudentName}"
@inject NavigationManager Navigation

<div class="container mt-5">
    <h2 class="mb-4">Student Dashboard</h2>

    @if (!string.IsNullOrEmpty(closedMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show mb-4 shadow-sm" role="alert">
            <strong>Notice:</strong> @closedMessage
            <button type="button" class="btn-close" @onclick="() => closedMessage = string.Empty"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Online Registration Card -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h4 class="card-title text-primary">Online Registration</h4>
                        <p class="card-text text-muted">
                            Register for your upcoming semester courses, select your preferred section slots, and manage your weekly timetable.
                        </p>
                    </div>
                    <div class="mt-4">
                        <button class="btn btn-primary w-100 @(IsRegistrationOpen ? "" : "disabled")" 
                                @onclick="GoToRegistration">
                            Go to Registration
                        </button>
                        @if (!IsRegistrationOpen)
                        {
                            <small class="text-danger d-block mt-2 text-center">
                                Registration opens Aug 25, 2026 - Sep 13, 2026.
                            </small>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Print Unofficial Transcript Card -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-secondary">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h4 class="card-title text-secondary">Unofficial Transcript</h4>
                        <p class="card-text text-muted">
                            View and print your complete academic history, completed courses, grades, and cumulative GPA.
                        </p>
                    </div>
                    <div class="mt-4">
                        <button class="btn btn-outline-secondary w-100" @onclick="GoToTranscript">
                            Print Unofficial Transcript
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int StudentId { get; set; }
    [Parameter] public int MajorId { get; set; }
    [Parameter] public int FacultyId { get; set; }
    [Parameter] public string StudentName { get; set; } = string.Empty;

    private string closedMessage = string.Empty;

    private readonly DateTime registrationStartDate = new DateTime(2026, 8, 25, 0, 0, 0);
    private readonly DateTime registrationEndDate = new DateTime(2026, 9, 13, 23, 59, 59);
    private bool IsRegistrationOpen => DateTime.Now >= registrationStartDate && DateTime.Now <= registrationEndDate;
    
    private void GoToRegistration()
    {
        if (IsRegistrationOpen)
        {
            Navigation.NavigateTo($"/registration/{StudentId}/{FacultyId}/{MajorId}");
        }
        else
        {
            closedMessage = "Registration is currently closed.";
        }
    }

    private void GoToTranscript()
    {
        Navigation.NavigateTo($"/transcript/{StudentId}");
    }
}